{
    "name": "jdz/sitemap",
    "type": "library",
    "description": "JDZ Sitemap generator",
    "keywords": [
        "JDZ",
        "utilities",
        "sitemap",
        "services"
    ],
    "homepage": "https://jdz.joffreydemetz.com/sitemap",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\Sitemap\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\Sitemap\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --testdox"
    }
}
